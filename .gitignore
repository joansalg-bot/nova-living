# ============================================================
# NOVA LIVING - ARCHIVOS QUE NO DEBEN SUBIRSE A GIT
# ============================================================

# Entornos virtuales
venv/
.venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class

# Base de datos local
# La dejamos fuera porque el servidor tendrá su propia base.
database/*.db
database/*.sqlite
database/*.sqlite3

# Variables de entorno y secretos
.env
.env.*
!.env.example

# Sistema operativo
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/

# Archivos temporales
*.tmp
*.temp
*.log